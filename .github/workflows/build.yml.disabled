name: Build

on:
  push:
    branches: ["master"]
    paths:
      - 'src/**'
      - 'build.gradle.kts'
      - 'gradle.properties'
      - 'gradle/**'
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    environment: workflows
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v4

      - name: Set up JDK 21
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "21"
          cache: gradle

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4

      - name: Bump shared build number
        id: buildnum
        env:
          GH_TOKEN: ${{ secrets.VARS_PAT }}
          REPO: ${{ github.repository }}
          CURRENT: ${{ vars.BUILD_NUMBER }}
        run: |
          next=$(( ${CURRENT:-0} + 1 ))
          gh variable set BUILD_NUMBER --repo "$REPO" --env workflows --body "$next"
          echo "build_number=$next" >> "$GITHUB_OUTPUT"

      - name: Build jar
        env:
          MOD_BUILD_NUMBER: ${{ steps.buildnum.outputs.build_number }}
        run: |
          chmod +x gradlew
          ./gradlew build

      - name: Send jars to Discord
        env:
          DISCORD_WEBHOOK: ${{ secrets.DISCORD_WEBHOOK }}
          BRANCH: ${{ github.ref_name }}
        run: |
          shopt -s nullglob
          args=(-fsS -F "payload_json={\"content\":\"New build on ${BRANCH}\"}")
          i=0
          for f in build/libs/*.jar; do
            case "$f" in
              *-sources.jar|*-javadoc.jar) continue ;;
            esac
            name="$(basename "$f" | tr '+' '-')"
            args+=(-F "files[$i]=@$f;filename=$name")
            i=$((i + 1))
          done
          curl "${args[@]}" "$DISCORD_WEBHOOK"
